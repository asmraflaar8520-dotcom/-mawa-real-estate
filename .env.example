# MA'WA Environment Configuration
PROJECT_NAME="MA'WA | مأوى"
ENVIRONMENT="development"
SECRET_KEY="change_this_to_a_secure_random_64_character_hex_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite default for local dev, seamlessly migratable to PostgreSQL)
DATABASE_URL="sqlite:///./mawa.db"

# Storage paths
STORAGE_PRIVATE_DIR="./storage/private_docs"
STORAGE_PUBLIC_DIR="./storage/public_media"

# Security & CORS
ALLOWED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"
MAX_UPLOAD_SIZE_MB=5
