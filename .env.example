# ==============================================================================
# منصة مأوى العقارية — إعدادات البيئة (MA'WA Environment Configuration)
# ==============================================================================

PROJECT_NAME="MA'WA | مأوى"
ENVIRONMENT="development"  # غيّرها إلى "production" عند النشر على Vercel
SECRET_KEY="change_this_to_a_secure_random_64_character_hex_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 1. قاعدة البيانات (Database Configuration)
# ------------------------------------------------------------------------------
# محلياً (Local):
DATABASE_URL="sqlite:///./mawa.db"

# سحابياً عبر Supabase PostgreSQL (مجاناً 100% بدون فيزا):
# انسخ رابط الاتصال من Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# ------------------------------------------------------------------------------
# 2. تخزين الملفات والصور السحابي (Supabase Cloud Storage - Free Tier)
# ------------------------------------------------------------------------------
# عند تركها فارغة، يتم التخزين محلياً على القرص.
# عند إدخال بيانات Supabase، يتم رفع صور العقارات ومستندات التوثيق سحابياً على Supabase تلقائياً:
SUPABASE_URL=""       # مثال: https://xyzcompany.supabase.co
SUPABASE_KEY=""       # من Supabase Dashboard -> Project Settings -> API -> service_role key أو anon key
SUPABASE_STORAGE_MEDIA_BUCKET="mawa-media"
SUPABASE_STORAGE_DOCS_BUCKET="mawa-private-docs"

# مسارات التخزين المحلي الاحتياطي
STORAGE_PRIVATE_DIR="./storage/private_docs"
STORAGE_PUBLIC_DIR="./storage/public_media"

# ------------------------------------------------------------------------------
# 3. الأمان ونطاقات الويب المسموحة (Security & CORS)
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000,https://mawa-real-estate.vercel.app"
MAX_UPLOAD_SIZE_MB=5
